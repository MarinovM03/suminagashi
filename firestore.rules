rules_version = '2';

// The gallery is shelved, so no browser can read or write anything.
// The Firebase console bypasses these rules and can still manage the data.
// Deploy: npx firebase-tools deploy --only firestore:rules

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
